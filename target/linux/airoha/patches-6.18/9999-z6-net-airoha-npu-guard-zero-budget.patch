+/* Only this exact program/data pair has the reviewed zero-budget guard.
+ * The files remain unchanged; patch the DRAM copy before starting the cores.
+ */
 static int airoha_npu_load_firmware(struct device *dev, void __iomem *addr,
-				    const char *fw_name, int fw_max_size)
-{
-	const struct firmware *fw;
-	int ret;
-
-	ret = request_firmware_direct(&fw, fw_name, dev);
-	if (ret)
-		return dev_err_probe(dev, ret == -ENOENT ? -EPROBE_DEFER : ret,
-				     "failed to load %s\n", fw_name);
-
-	if (fw->size > fw_max_size) {
-		dev_err(dev, "%s: fw size too overlimit (%zu)\n",
-			fw_name, fw->size);
-		ret = -E2BIG;
-		goto out;
-	}
-
-	memcpy_toio(addr, fw->data, fw->size);
+				    void __iomem *base,
+				    const struct airoha_npu_fw *program,
+				    const struct airoha_npu_fw *data)
+{
+	static const u8 program_sha256[SHA256_DIGEST_SIZE] = {
+		0xe7, 0x43, 0xd1, 0xb5, 0x9a, 0x9c, 0xa6, 0xd0,
+		0x43, 0xe3, 0x8f, 0xf7, 0x10, 0x75, 0xe8, 0xd2,
+		0x87, 0x02, 0xa1, 0x04, 0xb9, 0x4a, 0xbb, 0x17,
+		0xa4, 0x03, 0x55, 0x14, 0xef, 0xda, 0x46, 0x43,
+	};
+	static const u8 data_sha256[SHA256_DIGEST_SIZE] = {
+		0x61, 0xa7, 0x5a, 0xfb, 0x05, 0x2f, 0xee, 0xd2,
+		0xce, 0xb2, 0xf3, 0x02, 0x3e, 0x16, 0xf5, 0x03,
+		0x17, 0xc0, 0x5c, 0x78, 0xf9, 0xc8, 0xe5, 0x64,
+		0xbf, 0x01, 0x92, 0x4c, 0xe3, 0x9c, 0x7e, 0xc1,
+	};
+	static const u8 guarded_sha256[SHA256_DIGEST_SIZE] = {
+		0x38, 0x9c, 0xfe, 0xcb, 0x07, 0x4f, 0xc2, 0x1c,
+		0x16, 0x30, 0x06, 0xc7, 0x91, 0xb6, 0x5f, 0x96,
+		0x28, 0xfe, 0x79, 0x0c, 0xfb, 0x68, 0x2f, 0x2e,
+		0x28, 0x8b, 0x71, 0xc1, 0x41, 0x04, 0xa7, 0x36,
+	};
+	static const u8 old_insn[] = { 0x93, 0x74, 0xf5, 0x0f };
+	static const u8 new_insn[] = { 0xe2, 0x84, 0xe1, 0xc5 };
+	const struct airoha_npu_fw *images[] = { program, data };
+	const struct firmware *fw[2] = {};
+	u8 digest[SHA256_DIGEST_SIZE], buffer[256];
+	struct sha256_ctx hash;
+	bool guard = false;
+	size_t offset, count;
+	int i, ret;
+
+	/* Request both roles before copying either image. */
+	for (i = 0; i < ARRAY_SIZE(fw); i++) {
+		ret = request_firmware_direct(&fw[i], images[i]->name, dev);
+		if (ret) {
+			ret = dev_err_probe(dev,
+					    ret == -ENOENT ? -EPROBE_DEFER : ret,
+					    "failed to load %s\n", images[i]->name);
+			goto out;
+		}
+
+		if (fw[i]->size > images[i]->max_size) {
+			dev_err(dev, "%s: fw size too overlimit (%zu)\n",
+				images[i]->name, fw[i]->size);
+			ret = -E2BIG;
+			goto out;
+		}
+	}
+
+	if (fw[0]->size == 122336 && fw[1]->size == 3084 &&
+	    !memcmp(fw[0]->data + 0x9e1a, old_insn, sizeof(old_insn))) {
+		sha256(fw[0]->data, fw[0]->size, digest);
+		if (!memcmp(digest, program_sha256, sizeof(digest))) {
+			sha256(fw[1]->data, fw[1]->size, digest);
+			guard = !memcmp(digest, data_sha256, sizeof(digest));
+		}
+	}
+
+	memcpy_toio(addr, fw[0]->data, fw[0]->size);
+	memcpy_toio(base + REG_NPU_LOCAL_SRAM, fw[1]->data, fw[1]->size);
+	if (guard) {
+		/* The instruction offset is only 2-byte aligned. */
+		memcpy_toio(addr + 0x9e1a, new_insn, sizeof(new_insn));
+		wmb();
+		sha256_init(&hash);
+		for (offset = 0; offset < fw[0]->size; offset += count) {
+			count = min_t(size_t, sizeof(buffer), fw[0]->size - offset);
+			memcpy_fromio(buffer, addr + offset, count);
+			sha256_update(&hash, buffer, count);
+		}
+		sha256_final(&hash, digest);
+		if (memcmp(digest, guarded_sha256, sizeof(digest))) {
+			dev_err(dev, "NPU TX budget guard readback failed\n");
+			ret = -EIO;
+			goto out;
+		}
+	}
+
+	dev_info(dev, "NPU TX budget guard %s\n",
+		 guard ? "applied" : "not applicable");
 out:
-	release_firmware(fw);
+	for (i = 0; i < ARRAY_SIZE(fw); i++)
+		release_firmware(fw[i]);
 
 	return ret;
 }
