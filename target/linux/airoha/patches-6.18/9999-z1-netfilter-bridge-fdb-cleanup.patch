 EXPORT_SYMBOL_GPL(nf_flow_table_cleanup);
 
+#if IS_ENABLED(CONFIG_NET_SWITCHDEV)
+static bool nf_flow_fdb_matches(const struct flow_offload *flow,
+				const struct flow_fdb_cleanup *cleanup)
+{
+	int dir;
+
+	if (!test_bit(NF_FLOW_BRIDGE, &flow->flags) ||
+	    !net_eq(nf_ct_net(flow->ct), cleanup->net) ||
+	    (s64)(flow->fdb_gen - cleanup->gen) >= 0)
+		return false;
+
+	/* This candidate is limited to the supported untagged bridge path. */
+	if (flow->tuplehash[0].tuple.encap_num ||
+	    flow->tuplehash[1].tuple.encap_num)
+		return false;
+
+	for (dir = 0; dir < FLOW_OFFLOAD_DIR_MAX; dir++) {
+		const struct flow_offload_tuple *tuple = &flow->tuplehash[dir].tuple;
+
+		if (tuple->xmit_type == FLOW_OFFLOAD_XMIT_DIRECT &&
+		    tuple->out.ifidx == cleanup->ifindex &&
+		    ether_addr_equal(tuple->out.h_dest, cleanup->addr))
+			return true;
+	}
+
+	return false;
+}
+
+static void nf_flow_fdb_cleanup_one(struct nf_flowtable *flowtable,
+				    struct flow_offload *flow, void *data)
+{
+	if (nf_flow_fdb_matches(flow, data))
+		flow_offload_teardown(flow);
+}
+
+static void nf_flow_fdb_cleanup_work(struct work_struct *work)
+{
+	struct flow_fdb_cleanup *cleanup =
+		container_of(work, struct flow_fdb_cleanup, work);
+	struct nf_flowtable *flowtable;
+
+	mutex_lock(&flowtable_lock);
+	list_for_each_entry(flowtable, &flowtables, list) {
+		if (flowtable->type->family != NFPROTO_BRIDGE ||
+		    !net_eq(read_pnet(&flowtable->net), cleanup->net))
+			continue;
+
+		nf_flow_table_iterate(flowtable, nf_flow_fdb_cleanup_one, cleanup);
+		/* Let the existing GC serialize deletion and retry pending HW work.
+		 * Do not run a second, concurrent GC or free driver-owned entries.
+		 */
+		mod_delayed_work(system_power_efficient_wq, &flowtable->gc_work, 0);
+	}
+	mutex_unlock(&flowtable_lock);
+	put_net(cleanup->net);
+	kfree(cleanup);
+}
+
+static int nf_flow_fdb_event(struct notifier_block *nb,
+			     unsigned long event, void *ptr)
+{
+	struct switchdev_notifier_fdb_info *fdb = ptr;
+	struct flow_fdb_cleanup *cleanup;
+	struct net_device *dev;
+
+	if (event != SWITCHDEV_FDB_DEL_TO_DEVICE || !fdb || !fdb->addr)
+		return NOTIFY_DONE;
+
+	dev = switchdev_notifier_info_to_dev(&fdb->info);
+	if (!dev || !netif_is_bridge_port(dev) || fdb->is_local || fdb->vid ||
+	    !is_valid_ether_addr(fdb->addr))
+		return NOTIFY_DONE;
+
+	cleanup = kmalloc(sizeof(*cleanup), GFP_ATOMIC);
+	if (!cleanup)
+		return NOTIFY_DONE;
+
+	cleanup->net = get_net(dev_net(dev));
+	cleanup->ifindex = dev->ifindex;
+	ether_addr_copy(cleanup->addr, fdb->addr);
+	INIT_WORK(&cleanup->work, nf_flow_fdb_cleanup_work);
+	spin_lock_bh(&flow_fdb_lock);
+	cleanup->gen = ++flow_fdb_gen;
+	spin_unlock_bh(&flow_fdb_lock);
+	queue_work(flow_fdb_wq, &cleanup->work);
+	return NOTIFY_DONE;
+}
+
+static struct notifier_block flow_fdb_notifier = {
+	.notifier_call = nf_flow_fdb_event,
+};
+#endif
+
 void nf_flow_table_free(struct nf_flowtable *flow_table)
 {
