+int flow_offload_add(struct nf_flowtable *flow_table, struct flow_offload *flow)
+{
+#if IS_ENABLED(CONFIG_NET_SWITCHDEV)
+	int err;
+
+	if (test_bit(NF_FLOW_BRIDGE, &flow->flags)) {
+		/* ponytail: one lock for new bridge flows; shard only if measured.
+		 * Publish both tuples before an FDB event can capture its cutoff.
+		 * Otherwise a deferred walk could miss an in-flight insertion.
+		 */
+		spin_lock_bh(&flow_fdb_lock);
+		flow->fdb_gen = flow_fdb_gen;
+		err = __flow_offload_add(flow_table, flow);
+		spin_unlock_bh(&flow_fdb_lock);
+		return err;
+	}
+#endif
+	return __flow_offload_add(flow_table, flow);
+}
