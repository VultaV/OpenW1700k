Subject: [PATCH] net: airoha: preserve PPE ownership across relearning

Only bind the newest matching software rule to a learned physical slot.
Forget older associations to that slot without clearing unrelated colliding
flows, and check the current tuple before invalidating an aged slot.
Track L2 subflow data and bucket membership to apply the same lifetime
rules to these entries.

Host sanitizers check duplicate rules, slot reuse, collisions, packet
type, subflow lifetime, stale statistics and failed old-slot reads.
Hardware timing and reconnect behavior still need runtime validation.

---
--- a/drivers/net/ethernet/airoha/airoha_ppe.c
+++ b/drivers/net/ethernet/airoha/airoha_ppe.c
@@ -737,7 +737,8 @@
 	int type = FIELD_GET(AIROHA_FOE_IB1_BIND_PACKET_TYPE, e->data.ib1);
 	int len;
 
-	if ((hwe->ib1 ^ e->data.ib1) & AIROHA_FOE_IB1_BIND_UDP)
+	if ((hwe->ib1 ^ e->data.ib1) &
+	    (AIROHA_FOE_IB1_BIND_UDP | AIROHA_FOE_IB1_BIND_PACKET_TYPE))
 		return false;
 
 	if (type > PPE_PKT_TYPE_IPV4_DSLITE)
@@ -806,19 +807,48 @@
 	return err;
 }
 
+static int airoha_ppe_foe_clear_entry(struct airoha_ppe *ppe,
+				      struct airoha_flow_table_entry *e)
+{
+	struct airoha_foe_entry *hwe;
+	u32 state;
+	int err;
+
+	lockdep_assert_held(&ppe_lock);
+
+	if (e->hash == 0xffff)
+		return 0;
+
+	hwe = airoha_ppe_foe_get_entry_locked(ppe, e->hash);
+	if (!hwe)
+		return -EIO;
+
+	state = FIELD_GET(AIROHA_FOE_IB1_BIND_STATE, hwe->ib1);
+	/* Hardware may have aged and reused this slot for another tuple. */
+	if ((state == AIROHA_FOE_STATE_BIND || state == AIROHA_FOE_STATE_FIN) &&
+	    airoha_ppe_foe_compare_entry(e, hwe)) {
+		/* Preserve the current tuple and statistics routing on invalidation. */
+		hwe->ib1 &= ~AIROHA_FOE_IB1_BIND_STATE;
+		/* Publish the invalid state before issuing the SRAM write. */
+		wmb();
+		if (e->hash < airoha_ppe_get_total_sram_num_entries(ppe)) {
+			err = airoha_ppe_foe_commit_sram_entry(ppe, e->hash);
+			if (err)
+				return err;
+		}
+	}
+	e->hash = 0xffff;
+
+	return 0;
+}
+
 static void airoha_ppe_foe_remove_flow(struct airoha_ppe *ppe,
 				       struct airoha_flow_table_entry *e)
 {
 	lockdep_assert_held(&ppe_lock);
 
 	hlist_del_init(&e->list);
-	if (e->hash != 0xffff) {
-		e->data.ib1 &= ~AIROHA_FOE_IB1_BIND_STATE;
-		e->data.ib1 |= FIELD_PREP(AIROHA_FOE_IB1_BIND_STATE,
-					  AIROHA_FOE_STATE_INVALID);
-		airoha_ppe_foe_commit_entry(ppe, &e->data, e->hash, false);
-		e->hash = 0xffff;
-	}
+	airoha_ppe_foe_clear_entry(ppe, e);
 	if (e->type == FLOW_TYPE_L2_SUBFLOW) {
 		hlist_del_init(&e->l2_subflow_node);
 		kfree(e);
@@ -896,7 +926,10 @@
 	}
 
 	hwe.bridge.data = e->data.bridge.data;
-	airoha_ppe_foe_commit_entry(ppe, &hwe, hash, rx_wlan);
+	f->data = hwe;
+	hlist_add_head(&f->list,
+		       &ppe->foe_flow[airoha_ppe_foe_get_entry_hash(ppe, &hwe)]);
+	airoha_ppe_foe_commit_entry(ppe, &f->data, hash, rx_wlan);
 
 	return 0;
 }
@@ -905,10 +938,9 @@
 					struct sk_buff *skb,
 					u32 hash, bool rx_wlan)
 {
-	struct airoha_flow_table_entry *e;
+	struct airoha_flow_table_entry *e, *entry = NULL;
 	struct airoha_foe_bridge br = {};
 	struct airoha_foe_entry *hwe;
-	bool commit_done = false;
 	struct hlist_node *n;
 	u32 index, state;
 
@@ -919,30 +951,34 @@
 		goto unlock;
 
 	state = FIELD_GET(AIROHA_FOE_IB1_BIND_STATE, hwe->ib1);
-	if (state == AIROHA_FOE_STATE_BIND)
+	if (state != AIROHA_FOE_STATE_UNBIND)
 		goto unlock;
 
 	index = airoha_ppe_foe_get_entry_hash(ppe, hwe);
 	hlist_for_each_entry_safe(e, n, &ppe->foe_flow[index], list) {
-		if (e->type == FLOW_TYPE_L2_SUBFLOW) {
-			state = FIELD_GET(AIROHA_FOE_IB1_BIND_STATE, hwe->ib1);
-			if (state != AIROHA_FOE_STATE_BIND) {
-				e->hash = 0xffff;
+		/* A software hash bucket can contain several physical slots. */
+		if (e->hash == hash) {
+			e->hash = 0xffff;
+			if (e->type == FLOW_TYPE_L2_SUBFLOW) {
 				airoha_ppe_foe_remove_flow(ppe, e);
+				continue;
 			}
+		}
+		if (e->type == FLOW_TYPE_L2_SUBFLOW)
 			continue;
-		}
-
-		if (!airoha_ppe_foe_compare_entry(e, hwe))
-			continue;
-
-		airoha_ppe_foe_commit_entry(ppe, &e->data, hash, rx_wlan);
-		commit_done = true;
-		e->hash = hash;
-	}
-
-	if (commit_done)
+
+		/* Registration adds at the head: only the newest matching rule wins. */
+		if (!entry && airoha_ppe_foe_compare_entry(e, hwe))
+			entry = e;
+	}
+
+	if (entry) {
+		if (airoha_ppe_foe_clear_entry(ppe, entry))
+			goto unlock;
+		entry->hash = hash;
+		airoha_ppe_foe_commit_entry(ppe, &entry->data, hash, rx_wlan);
 		goto unlock;
+	}
 
 	airoha_ppe_foe_set_bridge_addrs(&br, eth_hdr(skb));
 	e = rhashtable_lookup_fast(&ppe->l2_flows, &br,
@@ -1033,7 +1069,8 @@
 
 		ib1 = READ_ONCE(hwe->ib1);
 		state = FIELD_GET(AIROHA_FOE_IB1_BIND_STATE, ib1);
-		if (state != AIROHA_FOE_STATE_BIND) {
+		if (state != AIROHA_FOE_STATE_BIND ||
+		    !airoha_ppe_foe_compare_entry(iter, hwe)) {
 			iter->hash = 0xffff;
 			airoha_ppe_foe_remove_flow(ppe, iter);
 			continue;
@@ -1069,7 +1106,9 @@
 		goto unlock;
 
 	memcpy(&hwe, hwe_p, sizeof(*hwe_p));
-	if (!airoha_ppe_foe_compare_entry(e, &hwe)) {
+	if (!airoha_ppe_foe_compare_entry(e, &hwe) ||
+	    FIELD_GET(AIROHA_FOE_IB1_BIND_STATE, hwe.ib1) !=
+	    AIROHA_FOE_STATE_BIND) {
 		e->hash = 0xffff;
 		goto unlock;
 	}
