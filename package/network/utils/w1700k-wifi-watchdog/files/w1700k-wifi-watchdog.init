#!/bin/sh /etc/rc.common

START=99
USE_PROCD=1

start_service() {
	[ "$(cat /tmp/sysinfo/board_name 2>/dev/null)" = "gemtek,w1700k-ubi" ] || return 0
	procd_open_instance
	procd_set_param command /usr/sbin/w1700k-wifi-watchdog
	procd_set_param term_timeout 70
	procd_set_param respawn
	procd_close_instance
}
