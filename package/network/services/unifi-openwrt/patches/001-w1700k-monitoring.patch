+// mldLink is one affiliated link of an MLD AP interface (hostapd -l <id>).
+type mldLink struct {
+	ID           int
+	Band, BSSID  string
+	VHT, HE, EHT bool
+	Stations     map[string]bool
+}
+
+func parseMLD(b []byte) []mldLink {
+	var out []mldLink
+	at := map[int]int{}
+	for _, line := range strings.Split(string(b), "\n") {
+		number, kv, ok := strings.Cut(strings.TrimSpace(line), " ")
+		k, v, ok2 := strings.Cut(kv, "=")
+		id, err := strconv.Atoi(number)
+		if !ok || !ok2 || err != nil || id < 0 || id > 15 {
+			continue
+		}
+		i, seen := at[id]
+		if !seen {
+			out = append(out, mldLink{ID: id, Stations: map[string]bool{}})
+			i = len(out) - 1
+			at[id] = i
+		}
+		l := &out[i]
+		switch k {
+		case "freq":
+			l.Band = frequencyBand(int(atoi(v)))
+		case "bssid[0]":
+			if mac, err := net.ParseMAC(v); err == nil && len(mac) == 6 {
+				l.BSSID = mac.String()
+			}
+		case "ieee80211ac":
+			l.VHT = v == "1"
+		case "ieee80211ax":
+			l.HE = v == "1"
+		case "ieee80211be":
+			l.EHT = v == "1"
+		case "sta":
+			l.Stations[strings.ToLower(v)] = true
+		}
+	}
+	sort.Slice(out, func(i, j int) bool { return out[i].ID < out[j].ID })
+	return out
+}
