+func readLinkInfo(r *Radio, iface string, secs *secMap) {
+	band := map[string]string{"ng": "1:", "na": "2:", "6e": "4:"}[r.Band]
+	for _, line := range strings.Split(string(secs.get("ant "+iface)), "\n") {
+		f := strings.Fields(line)
+		if len(f) != 3 || f[1] != band {
+			continue
+		}
+		switch f[0] {
+		case "band":
+			r.NSS = int(atoi(f[2]))
+		case "width":
+			r.W160 = r.W160 || f[2] == "160" || f[2] == "320"
+			r.W320 = r.W320 || (r.Band == "6e" && f[2] == "320")
+		case "usable":
+			r.Usable6 = r.Usable6 || (r.Band == "6e" && f[2] == "6g")
+		}
+	}
+	lines := strings.Split(string(secs.get("channels "+iface)), "\n")
+	for i, line := range lines {
+		var channel, freq, width int
+		if n, _ := fmt.Sscanf(strings.TrimSpace(line), "channel %d (%d MHz), width: %d MHz", &channel, &freq, &width); n == 3 && frequencyBand(freq) == r.Band {
+			r.Channel, r.Width = channel, width
+			r.W160 = r.W160 || width >= 160
+			r.W320 = r.W320 || (r.Band == "6e" && width == 320)
+			var dbm float64
+			if i+1 < len(lines) {
+				if n, _ := fmt.Sscanf(strings.TrimSpace(lines[i+1]), "txpower %f dBm", &dbm); n == 1 {
+					r.TxPower = int(dbm)
+					r.TxMax = max(r.TxMax, r.TxPower)
+				}
+			}
+			return
+		}
+	}
+}
