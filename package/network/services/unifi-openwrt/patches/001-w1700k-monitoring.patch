+// splitMLD spreads an MLD interface's VAP over the radios of its links:
+// each link's radio gets the link's capabilities and a VAP with the clients
+// on that link. iwinfo sees only one link (the netdev's), so without this
+// the other band shows no WLAN, no clients, Wi-Fi 4 and 0 dBm. A client
+// affiliated with several links is counted once, on its lowest link ID.
+// ponytail: no per-link traffic split; the netdev counters stay on the
+// VAP iwinfo sampled. Without hostapd_cli the VAP stays where it was.
+func splitMLD(radios []Radio, devs []wifiDevice, secs *secMap) {
+	type move struct {
+		to  int
+		vap Radio
+	}
+	var moves []move
+	ifaces := map[string][]string{}
+	for _, d := range devs {
+		ifaces[d.Section] = d.Ifaces
+	}
+	for ri := range radios {
+		for vi := range radios[ri].VAPs {
+			v := &radios[ri].VAPs[vi]
+			links := parseMLD(secs.get("mld " + v.Iface))
+			if len(links) == 0 {
+				continue
