--- /dev/null
+++ b/internal/openwrt/ports.go
@@ -0,0 +1,53 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+package openwrt
+
+import (
+	"encoding/json"
+	"strings"
+)
+
+// netifd exposes the PHY-supported modes even when no cable is connected.
+type portLink struct {
+	Supported []string `json:"link-supported"`
+	Autoneg   *bool    `json:"autoneg"`
+}
+
+func parsePortLink(data []byte) portLink {
+	var link portLink
+	if json.Unmarshal(data, &link) != nil {
+		return portLink{}
+	}
+	return link
+}
+
+func (p portLink) autoNegotiating() bool {
+	return p.Autoneg == nil || *p.Autoneg
+}
+
+// UniFi PORTSPEED_* bits, keyed by speed in Mbps and duplex. Different
+// Ethernet media of the same speed map to the same bit.
+var portSpeedBits = map[string]int{
+	"10-H": 1, "10-F": 2, "100-H": 4, "100-F": 8, "1000-H": 16, "1000-F": 32,
+	"2500-F": 64, "5000-F": 128, "10000-F": 256, "20000-F": 4096,
+	"25000-F": 8192, "40000-F": 16384, "50000-F": 32768, "100000-F": 65536,
+}
+
+func (p portLink) speedCaps() int {
+	caps := 0
+	if p.Supported == nil {
+		// Preserve the historical copper GE default on older netifd.
+		caps = 1 | 2 | 4 | 8 | 32
+	}
+	for _, mode := range p.Supported {
+		speed, media, ok := strings.Cut(mode, "base")
+		if ok && len(media) > 2 {
+			caps |= portSpeedBits[speed+media[len(media)-2:]]
+		}
+	}
+	// netifd reports current autoneg, not a separate capability flag.
+	if p.autoNegotiating() {
+		caps |= 1 << 20
+	}
+	return caps
+}
