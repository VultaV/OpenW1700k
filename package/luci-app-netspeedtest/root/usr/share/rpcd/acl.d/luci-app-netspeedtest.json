{
  "luci-app-netspeedtest": {
    "description": "Grant access to netspeedtest procedures",
    "read": {
      "file": {
        "/tmp/speedtest_result": [ "read" ]
      },
      "ubus": {
        "service": [ "list" ],
        "luci.netspeedtest": [ "ookla_verify" ]
      },
      "uci": [ "netspeedtest", "librespeed-go" ]
    },
    "write": {
      "ubus": {
        "luci.netspeedtest": [ "download_ookla", "speedtest" ]
      },
      "uci": [ "netspeedtest", "librespeed-go" ]
    }
  }
}
