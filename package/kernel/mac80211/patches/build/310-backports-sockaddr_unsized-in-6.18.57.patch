From: VultaV <unc10@naver.com>
Subject: backports: match sockaddr_unsized availability in 6.18 stable

Linux 6.18.57 through 6.18.60 define struct sockaddr_unsized in
<linux/socket.h>. Linux 6.18.61 reverted that type, but retained the
__sockaddr_check_size macro. Supply the backport type again on
6.18.61 through 6.18.x; retain the native type from 6.19 onward.

--- a/backport-include/linux/socket.h
+++ b/backport-include/linux/socket.h
@@ -11,7 +11,8 @@
 #define SOL_NFC		280
 #endif
 
-#if LINUX_VERSION_IS_LESS(6,19,0)
+#if LINUX_VERSION_IS_LESS(6,18,57) || \
+    (LINUX_VERSION_IS_GEQ(6,18,61) && LINUX_VERSION_IS_LESS(6,19,0))
 /**
  * struct sockaddr_unsized - Unspecified size sockaddr for callbacks
  * @sa_family: Address family (AF_UNIX, AF_INET, AF_INET6, etc.)
@@ -28,7 +29,7 @@ struct sockaddr_unsized {
 	__kernel_sa_family_t	sa_family;	/* address family, AF_xxx */
 	char			sa_data[];	/* flexible address data */
 };
-#endif /* < 6.19 */
+#endif /* sockaddr_unsized not provided by the kernel */
 
 #ifndef __sockaddr_check_size
 #define __sockaddr_check_size(size)	\
