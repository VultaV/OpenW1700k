+++ b/mt7996/main.c
@@ -6,6 +6,48 @@
 #include "mt7996.h"
 #include "mcu.h"
 #include "mac.h"
+
+static bool mlo_ps_gate_fix = true;
+module_param_named(mlo_ps_gate_fix, mlo_ps_gate_fix, bool, 0600);
+MODULE_PARM_DESC(mlo_ps_gate_fix,
+	"Account for both active MLO links when gating the shared station TXQ");
+
+bool mt7996_txq_ps(struct mt76_wcid *wcid)
+{
+	struct mt7996_sta_link *primary, *secondary;
+	struct ieee80211_sta *sta;
+	struct mt7996_sta *msta;
+	u8 primary_id, secondary_id;
+
+	if (!test_bit(MT_WCID_FLAG_PS, &wcid->flags))
+		return false;
+	if (!READ_ONCE(mlo_ps_gate_fix) || !wcid->sta || !wcid->link_valid)
+		return true;
+	sta = wcid_to_sta(wcid);
+	if (!sta || !sta->mlo)
+		return true;
+	msta = (struct mt7996_sta *)sta->drv_priv;
+	primary_id = READ_ONCE(msta->deflink_id);
+	secondary_id = READ_ONCE(msta->seclink_id);
+	if (primary_id >= IEEE80211_MLD_MAX_NUM_LINKS ||
+	    secondary_id >= IEEE80211_MLD_MAX_NUM_LINKS ||
+	    primary_id == secondary_id || wcid->link_id != primary_id)
+		return true;
+
+	/* ponytail: limit to two-link MLO until three-link PS is verified. */
+	if (READ_ONCE(sta->valid_links) != (BIT(primary_id) | BIT(secondary_id)))
+		return true;
+	primary = mt7996_sta_link(msta, primary_id);
+	secondary = mt7996_sta_link(msta, secondary_id);
+	if (!primary || wcid != &primary->wcid || !secondary ||
+	    !secondary->wcid.link_valid || secondary->wcid.link_id != secondary_id)
+		return true;
+
+	/* The TXQs belong to the primary WCID, but serve both MLO links.
+	 * Keep per-link firmware PS flags and actual TX WCID selection intact.
+	 */
+	return test_bit(MT_WCID_FLAG_PS, &secondary->wcid.flags);
+}
 
 int mt7996_run(struct mt7996_phy *phy)
 {
