+bool mt7996_ba_trace;
+module_param_named(ba_trace, mt7996_ba_trace, bool, 0600);
+MODULE_PARM_DESC(ba_trace, "Trace BA action headers and firmware BA commands");
+
+static void
+mt7996_trace_ba_frame(struct mt7996_dev *dev, struct sk_buff *skb,
+		      unsigned int offset, struct mt76_wcid *wcid,
+		      int phy, bool rx)
+{
+	static DEFINE_RATELIMIT_STATE(limit, 5 * HZ, 64);
+	struct ieee80211_hdr saved_hdr;
+	const struct ieee80211_hdr *hdr;
+	u8 saved_body[9];
+	const u8 *body;
+	unsigned int body_offset, size;
+	u16 cap, tid, seq;
+	int token = -1, timeout = -1, ssn = -1, result = -1;
+
+	if (!READ_ONCE(mt7996_ba_trace) || offset > skb->len ||
+	    skb->len - offset < 24)
+		return;
+	hdr = skb_header_pointer(skb, offset, 24, &saved_hdr);
+	if (!hdr || !ieee80211_is_action(hdr->frame_control))
+		return;
+	seq = le16_to_cpu(hdr->seq_ctrl);
+	if (ieee80211_has_morefrags(hdr->frame_control) ||
+	    (seq & IEEE80211_SCTL_FRAG))
+		return;
+	body_offset = offset + ieee80211_hdrlen(hdr->frame_control);
+	body = skb_header_pointer(skb, body_offset, 2, saved_body);
+	if (!body || body[0] != WLAN_CATEGORY_BACK ||
+	    body[1] > WLAN_ACTION_DELBA)
+		return;
+	size = body[1] == WLAN_ACTION_DELBA ? 6 : 9;
+	body = skb_header_pointer(skb, body_offset, size, saved_body);
+	if (!body)
+		return;
+	if (body[1] == WLAN_ACTION_DELBA) {
+		cap = get_unaligned_le16(body + 2);
+		tid = FIELD_GET(IEEE80211_DELBA_PARAM_TID_MASK, cap);
+		result = get_unaligned_le16(body + 4);
+	} else {
+		token = body[2];
+		if (body[1] == WLAN_ACTION_ADDBA_REQ) {
+			cap = get_unaligned_le16(body + 3);
+			timeout = get_unaligned_le16(body + 5);
+			ssn = get_unaligned_le16(body + 7) >> 4;
+		} else {
+			result = get_unaligned_le16(body + 3);
+			cap = get_unaligned_le16(body + 5);
+			timeout = get_unaligned_le16(body + 7);
+		}
+		tid = FIELD_GET(IEEE80211_ADDBA_PARAM_TID_MASK, cap);
+	}
+	if (!__ratelimit(&limit))
+		return;
+	dev_info(dev->mt76.dev,
+		 "BATRACE dir=%c act=%u sa=%pM da=%pM wcid=%d link=%d phy=%d tok=%d tid=%u cap=%04x timeout=%d ssn=%d result=%d seq=%04x fc=%04x bytes=%u\n",
+		 rx ? 'R' : 'T', body[1], hdr->addr2, hdr->addr1,
+		 wcid ? wcid->idx : -1, wcid ? wcid->link_id : -1, phy,
+		 token, tid, cap, timeout, ssn, result, seq,
+		 le16_to_cpu(hdr->frame_control), skb->len);
+}
 
