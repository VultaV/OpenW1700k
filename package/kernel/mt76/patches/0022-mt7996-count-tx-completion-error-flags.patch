+static void mt7996_mac_txfree_diag(struct mt76_wcid *wcid, u32 info)
+{
+	struct mt7996_sta_link *link;
+
+	if (!wcid->sta)
+		return;
+	link = container_of(wcid, struct mt7996_sta_link, wcid);
+	atomic_inc(&link->txfree_status[FIELD_GET(MT_TXFREE_INFO_STAT, info)]);
+}
+
 static void
 mt7996_mac_tx_free(struct mt7996_dev *dev, void *data, int len)
 {
@@ -1310,6 +1320,7 @@
 
 			wcid->stats.tx_retries += tx_retries;
 			wcid->stats.tx_failed += tx_failed;
+			mt7996_mac_txfree_diag(wcid, info);
 			continue;
 		}
 
@@ -1337,6 +1348,22 @@
 		skb_list_del_init(skb);
 		napi_consume_skb(skb, 1);
 	}
+}
+
+static void mt7996_mac_txs_diag(struct mt76_wcid *wcid, u32 txs)
+{
+	struct mt7996_sta_link *link;
+	u8 format = FIELD_GET(MT_TXS0_TXS_FORMAT, txs);
+	int bit;
+
+	if (!wcid->sta)
+		return;
+	link = container_of(wcid, struct mt7996_sta_link, wcid);
+	link->txs_formats[format]++;
+	if (format)
+		return;
+	for (bit = 0; bit < ARRAY_SIZE(link->txs_mpdu_flags); bit++)
+		link->txs_mpdu_flags[bit] += !!(txs & BIT(16 + bit));
 }
 
