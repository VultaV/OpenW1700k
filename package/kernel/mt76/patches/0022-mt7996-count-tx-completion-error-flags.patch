Subject: [DIAGNOSTIC] mt7996: preserve sampled TX status flags

Record TXS formats, format-0 bits 16..22, and raw TXFREE status bins.
Counts are per WCID and wrap at 32 bits. Flags can overlap and do not
identify TCP packets. TXFREE bins use atomics across completion queues.
No radio commands, status frequency, TX selection, PS flags or ACK
classification are changed. This is not an MLO stall fix.

--- a/mt7996/debugfs.c
+++ b/mt7996/debugfs.c
@@ -682,6 +682,24 @@
 			   (unsigned long long)txs,
 			   READ_ONCE(msta_link->wcid.stats.tx_retries),
 			   READ_ONCE(msta_link->wcid.stats.tx_failed));
+		seq_printf(s, "\t\ttxs_formats: %u %u %u %u\n",
+			   READ_ONCE(msta_link->txs_formats[0]),
+			   READ_ONCE(msta_link->txs_formats[1]),
+			   READ_ONCE(msta_link->txs_formats[2]),
+			   READ_ONCE(msta_link->txs_formats[3]));
+		seq_printf(s, "\t\ttxs_mpdu_flags: ack:%u rts:%u queue:%u bip:%u txop:%u ps:%u ba:%u\n",
+			   READ_ONCE(msta_link->txs_mpdu_flags[0]),
+			   READ_ONCE(msta_link->txs_mpdu_flags[1]),
+			   READ_ONCE(msta_link->txs_mpdu_flags[2]),
+			   READ_ONCE(msta_link->txs_mpdu_flags[3]),
+			   READ_ONCE(msta_link->txs_mpdu_flags[4]),
+			   READ_ONCE(msta_link->txs_mpdu_flags[5]),
+			   READ_ONCE(msta_link->txs_mpdu_flags[6]));
+		seq_printf(s, "\t\ttxfree_status: %u %u %u %u\n",
+			   (u32)atomic_read(&msta_link->txfree_status[0]),
+			   (u32)atomic_read(&msta_link->txfree_status[1]),
+			   (u32)atomic_read(&msta_link->txfree_status[2]),
+			   (u32)atomic_read(&msta_link->txfree_status[3]));
 
 		mphy = mt76_vif_link_phy(mlink);
 		if (!mphy)
