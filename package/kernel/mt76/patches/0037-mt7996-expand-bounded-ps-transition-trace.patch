 			 char kind, u32 detail)
 {
-	static DEFINE_RATELIMIT_STATE(ps_limit, 5 * HZ, 128);
+	static DEFINE_RATELIMIT_STATE(ps_limit, 5 * HZ, 1024);
 	static DEFINE_RATELIMIT_STATE(free_limit, 5 * HZ, 8);
 	static atomic_t ps_seq = ATOMIC_INIT(0), free_seq = ATOMIC_INIT(0);
