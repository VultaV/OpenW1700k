From: VultaV <unc10@naver.com>
Subject: [PATCH] mt7996: report the per-link txpower

mt7996_get_txpower() ignored link_id and always returned the default
link's phy power, so "iw dev ap-mld0 info" showed the 6 GHz regulatory
limit (18 dBm) for the 5 GHz link too, although that phy was running at
its own 23 dBm limit. Look the link up by link_id and fall back to the
default link only when it has no phy.

Signed-off-by: VultaV <unc10@naver.com>
---
--- a/mt7996/main.c
+++ b/mt7996/main.c
@@ -922,11 +922,25 @@ mt7996_get_txpower(struct ieee80211_hw *
 		   unsigned int link_id, int *dbm)
 {
 	struct mt7996_vif *mvif = (struct mt7996_vif *)vif->drv_priv;
-	struct mt7996_phy *phy = mt7996_vif_link_phy(&mvif->deflink);
 	struct mt7996_dev *dev = mt7996_hw_dev(hw);
+	struct mt7996_vif_link *link = NULL;
+	struct mt7996_phy *phy = NULL;
 	struct wireless_dev *wdev;
 	int n_chains, delta, i;
 
+	/* Each MLD link runs on its own band, so report that link's phy
+	 * instead of the default link's for every link.
+	 */
+	mutex_lock(&dev->mt76.mutex);
+	if (link_id < IEEE80211_MLD_MAX_NUM_LINKS)
+		link = mt7996_vif_link(dev, vif, link_id);
+	if (link)
+		phy = mt7996_vif_link_phy(link);
+	mutex_unlock(&dev->mt76.mutex);
+
+	if (!phy)
+		phy = mt7996_vif_link_phy(&mvif->deflink);
+
 	if (!phy) {
 		wdev = ieee80211_vif_to_wdev(vif);
 		for (i = 0; i < hw->wiphy->n_radio; i++)
