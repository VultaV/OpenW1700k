Subject: mt7996: initialize vendor RED protocol for NPU offload

Experimental backport of MediaTek non-WED offload RED initialization.
Use current host token budget, preserve other device/offload paths.
WM acknowledgement is not WA configuration readback.

--- a/mt7996/mcu.c
+++ b/mt7996/mcu.c
@@ -4309,6 +4309,68 @@
 				     MCU_WM_UNI_CMD(VOW), true);
 }
 
+/* MT7996 RED protocol from MediaTek's non-WED offload support. */
+static int mt7996_mcu_init_npu_red(struct mt7996_dev *dev)
+{
+#define RED_TOKEN_SRC_CNT 4
+	struct {
+		u8 rsv[4];
+		__le16 tag;
+		__le16 len;
+		u8 enable;
+		u8 rsv2[3];
+	} __packed wm = {
+		.tag = cpu_to_le16(UNI_VOW_RED_ENABLE),
+		.len = cpu_to_le16(sizeof(wm) - 4),
+		.enable = 2, /* RED controlled by WA */
+	};
+	struct {
+		__le32 args[3];
+		u8 mode;
+		u8 version;
+		u8 rsv[4];
+		__le16 len;
+		__le16 tcp_offset;
+		__le16 priority_offset;
+		__le16 token_per_src[RED_TOKEN_SRC_CNT];
+		__le16 token_thr_per_src[RED_TOKEN_SRC_CNT];
+		u8 rsv2[604];
+	} __packed wa = {
+		.args = { cpu_to_le32(MCU_WA_PARAM_RED_CONFIG), 0, 0 },
+		.mode = 2,
+		.len = cpu_to_le16(sizeof(wa) - sizeof(wa.args)),
+		.tcp_offset = cpu_to_le16(200),
+		.priority_offset = cpu_to_le16(255),
+	};
+	int i, ret;
+
+	for (i = 0; i < RED_TOKEN_SRC_CNT; i++) {
+		wa.token_per_src[i] = cpu_to_le16(MT7996_TOKEN_SIZE);
+		wa.token_thr_per_src[i] = cpu_to_le16(MT7996_TOKEN_SIZE);
+	}
+	wa.token_per_src[RED_TOKEN_SRC_CNT - 1] =
+		cpu_to_le16(dev->mt76.token_size);
+
+	ret = mt76_mcu_send_msg(&dev->mt76, MCU_WM_UNI_CMD(VOW),
+			      &wm, sizeof(wm), true);
+	if (ret)
+		return ret;
+
+	ret = mt7996_mcu_wa_cmd(dev, MCU_WA_PARAM_CMD(SET),
+			       MCU_WA_PARAM_RED, 1, 0);
+	if (ret)
+		return ret;
+
+	ret = mt76_mcu_send_msg(&dev->mt76, MCU_WA_PARAM_CMD(SET),
+			      &wa, sizeof(wa), false);
+	if (!ret)
+		dev_info(dev->mt76.dev,
+			 "NPU RED: WM ACK, WA commands queued (host tokens %u)\n",
+			 dev->mt76.token_size);
+
+	return ret;
+}
+
 int mt7996_mcu_init_firmware(struct mt7996_dev *dev)
 {
 	int ret;
@@ -4350,6 +4412,9 @@
 	ret = mt7996_mcu_init_rx_airtime(dev);
 	if (ret)
 		return ret;
+
+	if (is_mt7996(&dev->mt76) && mt76_npu_device_active(&dev->mt76))
+		return mt7996_mcu_init_npu_red(dev);
 
 	return mt7996_mcu_wa_cmd(dev, MCU_WA_PARAM_CMD(SET),
 				 MCU_WA_PARAM_RED, 0, 0);
--- a/mt7996/mcu.h
+++ b/mt7996/mcu.h
@@ -420,6 +420,7 @@
 	MCU_WA_PARAM_CPU_UTIL = 0x0b,
 	MCU_WA_PARAM_RED = 0x0e,
 	MCU_WA_PARAM_HW_PATH_HIF_VER = 0x2f,
+	MCU_WA_PARAM_RED_CONFIG = 0x40,
 };
 
 enum mcu_mmps_mode {
@@ -1023,6 +1024,7 @@
 	UNI_VOW_FEATURE_CTRL,
 	UNI_VOW_RX_AT_AIRTIME_EN = 0x0b,
 	UNI_VOW_RX_AT_AIRTIME_CLR_EN = 0x0e,
+	UNI_VOW_RED_ENABLE = 0x18,
 };
 
