From: Codex <codex@local>
Subject: [PATCH] wifi: mt76: mt7996: show per-link PS using active link PHY

The embedded default VIF link has no channel context for a 5+6 GHz MLD.
Print host WCID state before resolving the active link PHY for hardware
queue reads, so the diagnostics include MLO peers and links without a
channel. Values are read-only snapshots under the existing RCU lock.

Index: mt76-2026.10.08~639e1287/mt7996/debugfs.c
===================================================================
--- mt76-2026.10.08~639e1287.orig/mt7996/debugfs.c
+++ mt76-2026.10.08~639e1287/mt7996/debugfs.c
@@ -783,6 +783,11 @@ mt7996_sta_hw_queue_read(void *data, str
 
 	rcu_read_lock();
 
+	seq_printf(s, "STA %pM valid_links:0x%04x primary:%d secondary:%d\n",
+		   sta->addr, READ_ONCE(sta->valid_links),
+		   READ_ONCE(msta->deflink_id),
+		   READ_ONCE(msta->seclink_id));
+
 	for_each_sta_active_link(vif, sta, link_sta, link_id) {
 		struct mt7996_sta_link *msta_link;
 		struct mt76_vif_link *mlink;
@@ -795,16 +800,21 @@ mt7996_sta_hw_queue_read(void *data, str
 		if (!mlink)
 			continue;
 
+		msta_link = mt7996_sta_link(msta, link_id);
+		if (!msta_link)
+			continue;
+
+		seq_printf(s, "\tlink:%d wcid:%d valid:%d ps:%d\n",
+			   link_id, msta_link->wcid.idx,
+			   READ_ONCE(msta_link->wcid.link_valid),
+			   test_bit(MT_WCID_FLAG_PS, &msta_link->wcid.flags));
+
 		phy = mt7996_vif_link_phy(container_of(mlink,
 						       struct mt7996_vif_link,
 						       mt76));
 		if (!phy)
 			continue;
 
-		msta_link = mt7996_sta_link(msta, link_id);
-		if (!msta_link)
-			continue;
-
 		wlan_idx = msta_link->wcid.idx;
 		cr = mt7996_ple_sta_cr(phy->dev, wlan_idx / 32);
 		for (ac = 0; ac < IEEE80211_NUM_ACS; ac++) {
