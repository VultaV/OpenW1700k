From: Codex <codex@local>
Subject: [PATCH] wifi: mt76: mt7996: resolve RC PHY from the affected link

Both link RC callbacks and bitrate-mask iteration reach this helper under
RCU. A 5+6 GHz MLD has no channel context on its embedded default VIF
link, so the old lookup discards rate updates before queuing rc_work.
Resolve the existing VIF link indexed by the affected station WCID, and
retain the guards for removed links and missing channel contexts.

--- a/mt7996/main.c
+++ b/mt7996/main.c
@@ -2002,14 +2002,20 @@
 					 struct mt7996_sta_link *msta_link)
 {
 	struct mt7996_sta *msta = msta_link->sta;
-	struct mt7996_phy *phy = mt7996_vif_link_phy(&msta->vif->deflink);
+	struct mt76_vif_link *mlink;
+	struct mt76_phy *mphy;
 	struct mt7996_dev *dev;
 	u32 *changed = data;
 
-	if (!phy)
+	mlink = rcu_dereference(msta->vif->mt76.link[msta_link->wcid.link_id]);
+	if (!mlink)
 		return;
 
-	dev = phy->dev;
+	mphy = mt76_vif_link_phy(mlink);
+	if (!mphy)
+		return;
+
+	dev = mt7996_hw_dev(mphy->hw);
 	spin_lock_bh(&dev->mt76.sta_poll_lock);
 
 	msta_link->changed |= *changed;
