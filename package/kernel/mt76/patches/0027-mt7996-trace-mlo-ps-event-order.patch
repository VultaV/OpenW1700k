+/* Diagnostic only. P detail: TLV tag << 2 | old PS << 1 | new PS.
+ * F detail: raw status1 TXFREE header, not a delivered-packet count.
+ */
+static bool ps_trace;
+module_param_named(ps_trace, ps_trace, bool, 0600);
+MODULE_PARM_DESC(ps_trace, "Trace MLO PS transitions and status1 snapshots, default off");
+
+void mt7996_trace_mlo_ps(struct mt7996_dev *dev, struct mt76_wcid *wcid,
+			 char kind, u32 detail)
+{
+	static DEFINE_RATELIMIT_STATE(ps_limit, 5 * HZ, 128);
+	static DEFINE_RATELIMIT_STATE(free_limit, 5 * HZ, 8);
+	static atomic_t ps_seq = ATOMIC_INIT(0), free_seq = ATOMIC_INIT(0);
+	struct mt7996_sta_link *primary, *secondary;
+	struct ieee80211_sta *sta;
+	struct mt7996_sta *msta;
+	u8 pid, sid;
+	u32 seq;
+
+	if (!READ_ONCE(ps_trace) || !wcid)
+		return;
+	sta = wcid_to_sta(wcid);
+	if (!sta || !sta->mlo)
+		return;
+	msta = (struct mt7996_sta *)sta->drv_priv;
+	pid = READ_ONCE(msta->deflink_id);
+	sid = READ_ONCE(msta->seclink_id);
+	if (pid >= IEEE80211_MLD_MAX_NUM_LINKS ||
+	    sid >= IEEE80211_MLD_MAX_NUM_LINKS || pid == sid ||
+	    READ_ONCE(sta->valid_links) != (BIT(pid) | BIT(sid)))
+		return;
+	primary = mt7996_sta_link(msta, pid);
+	secondary = mt7996_sta_link(msta, sid);
+	if (!primary || !secondary ||
+	    (wcid != &primary->wcid && wcid != &secondary->wcid))
+		return;
+
+	/* ponytail: bounded samples; sequence gaps identify omitted eligible events. */
+	seq = atomic_inc_return(kind == 'P' ? &ps_seq : &free_seq);
+	if (!__ratelimit(kind == 'P' ? &ps_limit : &free_limit))
+		return;
+	/* Independent host reads; not an atomic firmware/air-state snapshot. */
+	dev_info(dev->mt76.dev,
+		 "MLOPS kind=%c n=%u sta=%pM src=%u link=%u detail=%08x p=%u/%u/%d s=%u/%u/%d gate=%d non_aql=%d\n",
+		 kind, seq, sta->addr, wcid->idx, wcid->link_id, detail,
+		 pid, primary->wcid.idx,
+		 test_bit(MT_WCID_FLAG_PS, &primary->wcid.flags),
+		 sid, secondary->wcid.idx,
+		 test_bit(MT_WCID_FLAG_PS, &secondary->wcid.flags),
+		 mt7996_txq_ps(&primary->wcid),
+		 atomic_read(&primary->wcid.non_aql_packets));
+}
