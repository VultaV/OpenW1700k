Subject: mt7996: add default-off awake-WCID experiment for two-link MLO data

--- a/mt7996/mac.c
+++ b/mt7996/mac.c
@@ -918,6 +918,47 @@
 	return false;
 }
 
+static bool mlo_tx_awake_test;
+module_param_named(mlo_tx_awake_test, mlo_tx_awake_test, bool, 0600);
+MODULE_PARM_DESC(mlo_tx_awake_test,
+	"Test selecting the awake WCID for two-link MLO data (default off)");
+
+static u8
+mt7996_tx_awake_link(struct ieee80211_sta *sta, u8 preferred)
+{
+	struct mt7996_sta_link *selected, *other;
+	struct mt7996_sta *msta;
+	u8 primary_id, secondary_id, other_id;
+
+	if (!READ_ONCE(mlo_tx_awake_test) || !sta || !sta->mlo)
+		return preferred;
+	msta = (struct mt7996_sta *)sta->drv_priv;
+	primary_id = READ_ONCE(msta->deflink_id);
+	secondary_id = READ_ONCE(msta->seclink_id);
+	if (primary_id >= IEEE80211_MLD_MAX_NUM_LINKS ||
+	    secondary_id >= IEEE80211_MLD_MAX_NUM_LINKS ||
+	    primary_id == secondary_id ||
+	    (preferred != primary_id && preferred != secondary_id))
+		return preferred;
+
+	/* ponytail: two-link experiment; preserve three-link scheduling. */
+	if (READ_ONCE(sta->valid_links) != (BIT(primary_id) | BIT(secondary_id)))
+		return preferred;
+	other_id = preferred == primary_id ? secondary_id : primary_id;
+	selected = mt7996_sta_link(msta, preferred);
+	other = mt7996_sta_link(msta, other_id);
+	if (!selected || !other || !selected->wcid.link_valid ||
+	    !other->wcid.link_valid || selected->wcid.link_id != preferred ||
+	    other->wcid.link_id != other_id)
+		return preferred;
+
+	if (test_bit(MT_WCID_FLAG_PS, &selected->wcid.flags) &&
+	    !test_bit(MT_WCID_FLAG_PS, &other->wcid.flags))
+		return other_id;
+
+	return preferred;
+}
+
 int mt7996_tx_prepare_skb(struct mt76_dev *mdev, void *txwi_ptr,
 			  enum mt76_txq_id qid, struct mt76_wcid *wcid,
 			  struct ieee80211_sta *sta,
@@ -949,6 +990,7 @@
 		u8 tid = tx_info->skb->priority & IEEE80211_QOS_CTL_TID_MASK;
 
 		link_id = (tid % 2) ? msta->seclink_id : msta->deflink_id;
+		link_id = mt7996_tx_awake_link(sta, link_id);
 	} else {
 		link_id = u32_get_bits(info->control.flags,
 				       IEEE80211_TX_CTRL_MLO_LINK);
