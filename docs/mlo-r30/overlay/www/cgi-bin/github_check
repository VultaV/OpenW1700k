#!/bin/sh

fail() {
    printf 'Status: 502 Bad Gateway\r\nContent-Type: application/json\r\n\r\n'
    printf '{"error":"Could not fetch valid GitHub releases"}\n'
    exit 1
}

releases=$(curl -fSs --proto '=https' --connect-timeout 15 --max-time 30 \
    https://api.github.com/repos/VultaV/OpenW1700k/releases) || fail
# The image's jq is built without regex support (CONFIG_PACKAGE_jq, not
# jq-full), so test() and sub() always fail there; compare characters instead.
result=$(printf '%s' "$releases" | jq -ec 'def image: "-airoha-an7581-gemtek_w1700k-ubi-squashfs-sysupgrade.itb" as $board |
    startswith("openwrt") and endswith($board) and (ltrimstr("openwrt") | rtrimstr($board) |
        . == "" or (startswith("-") and length > 1 and all(explode[]; . == 45 or . == 46 or . == 95 or
            (. >= 48 and . <= 57) or (. >= 65 and . <= 90) or (. >= 97 and . <= 122))));
    if type != "array" then error("Invalid release list") else
    [.[] | .tag_name as $tag | .assets[] |
        select(.name | image) |
        {tag: $tag, url: .browser_download_url,
         version: (.name | ltrimstr("openwrt") | rtrimstr("-airoha-an7581-gemtek_w1700k-ubi-squashfs-sysupgrade.itb") |
             ltrimstr("-") | if . == "" then $tag else . end)}]
    end') || fail
printf 'Content-Type: application/json\r\nCache-Control: no-store\r\n\r\n%s\n' "$result"
