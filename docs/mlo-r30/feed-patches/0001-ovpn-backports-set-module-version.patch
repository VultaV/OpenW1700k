Subject: [PATCH] ovpn-backports: define module version for direct Kbuild

The OpenWrt recipe builds drivers/net/ovpn directly, bypassing the upstream
wrapper that defines OVPN_MODULE_VERSION. Supply the packaged source
version so MODULE_VERSION compiles when CONFIG_MODULE_STRIPPED is disabled.
This changes version metadata only.

---
--- a/kernel/ovpn-dco/Makefile
+++ b/kernel/ovpn-dco/Makefile
@@ -10,7 +10,7 @@
 
 PKG_NAME:=ovpn-backports
 PKG_VERSION:=7.1.0.2026080300
-PKG_RELEASE:=1
+PKG_RELEASE:=2
 
 PKG_SOURCE:=$(PKG_NAME)-$(PKG_VERSION).tar.gz
 PKG_SOURCE_URL:= \
@@ -49,7 +49,8 @@
 	$(KERNEL_NOSTDINC_FLAGS) \
 	-I$(PKG_BUILD_DIR)/include \
 	-I$(PKG_BUILD_DIR)/compat-include \
-	-include $(PKG_BUILD_DIR)/linux-compat.h
+	-include $(PKG_BUILD_DIR)/linux-compat.h \
+	-DOVPN_MODULE_VERSION=\\\"$(PKG_VERSION)\\\"
 
 EXTRA_KCONFIG:= \
 	CONFIG_OVPN=m
